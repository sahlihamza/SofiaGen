# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server
PORT=5055

# Database
MONGO_URI=mongodb://localhost:27017/sofiagen?charset=utf8

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here
JWT_SECRET_FOR_VERIFY=your_jwt_secret_for_verify_here
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Encryption
ENCRYPT_PASSWORD=your_32_digit_hex_encryption_password_here

# Stripe
STRIPE_KEY=your_stripe_secret_key
MAX_AMOUNT=10000.0
MIN_AMOUNT=10.0
AMOUNT_STEP=5.0
CURRENCY=usd
STRIPE_PAYMENT_DESCRIPTION=This is sofiagen payment with Stripe!

# URLs
STORE_URL=http://localhost:3000
ADMIN_URL=http://localhost:5100
MARKETING_URL=http://localhost:3002

# CORS — comma-separated list of allowed origins for the backend API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5100

# Marketing site (site vitrine) — consumed by the marketing service in
# docker-compose.yml. NEXT_PUBLIC_* are read at runtime in the marketing container.
NEXT_PUBLIC_API_URL_MARKETING=http://backend:5055/api
NEXT_PUBLIC_PARTNER_URL=http://localhost:5100
NEXT_PUBLIC_WHATSAPP=+216XXXXXXXX
NEXT_PUBLIC_LOGIN_URL=http://localhost:5100/login
NEXT_PUBLIC_SIGNUP_URL=http://localhost:5100/signup

# Email — platform SMTP (MAIL-01/MAIL-03). This is the ONLY place the
# platform's SMTP credentials live — never in the database (PlatformSettings
# only stores the send identity: fromName/fromEmail/replyTo, editable from
# the SuperAdmin UI). A store's own SMTP is separate and lives encrypted in
# the database instead (see MAIL-02) — these vars are the platform fallback
# used whenever a store has none configured, plus for every credential/
# security email (invitations, password resets, platform billing), which
# always go out over the platform transport regardless of store SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587/25 (STARTTLS) — set
# explicitly; only falls back to the port-465 convention when unset.
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
# Optional — defaults to SMTP_USER. Overridden at runtime by
# PlatformSettings.email.fromName/fromEmail when set (DB takes priority).
EMAIL_FROM="SofiaGen <your_email@gmail.com>"

# Deprecated aliases for the SMTP_* vars above — still read as a fallback so
# an existing .env keeps working, but new setups should use SMTP_* only.
SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
HOST=smtp.gmail.com
EMAIL_PORT=465

# Storage
STORAGE_DRIVER=local

# Malla — in-app AI assistant
# 32-byte base64 key used to encrypt per-store provider API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_PROVIDER_ENCRYPTION_KEY=
# Optional global fallback (used when a store has not configured a provider).
AI_API_URL=
AI_API_KEY=
AI_MODEL=glm-4-plus
